# Copie este arquivo para .env (na raiz do projeto) antes de rodar docker compose up.
# .env nao é versionado - cada ambiente define o seu proprio segredo.

# Gere um valor aleatorio com pelo menos 32 caracteres, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Opcionais - ja tem default sensato no docker-compose.yml
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# FORKIFY_BASE_URL=https://forkify-api.herokuapp.com/api/search
